# Data — never push raw or processed datasets to GitHub
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# OS / editor
.DS_Store
.vscode/
.idea/

# Outputs are regenerated by the pipeline; keep the folders, ignore large artifacts
outputs/figures/*.png
outputs/tables/*.csv
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
